# The network everything reads and writes against: studionet | bradbury
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# The deployed Unison. EMPTY ON PURPOSE: until this is set, every screen
# that would otherwise show a mark says so instead. Copy the address EXACTLY as
# `npm run deploy` prints it -- Studio matches the string literally, and the
# lowercase form of a real contract answers "not found".
#
# Addresses are PER NETWORK. Changing the network above without deploying again
# points the site at an address that does not exist there.
#
# In production this is  0xf21a97af77685CC10dcB076dEE646C51fC2f4BfF
NEXT_PUBLIC_UNISONLABS_ADDRESS=

# Where the three samples are fetched from -- by the VALIDATORS, not by your
# browser. A localhost origin is a different machine from a node, so on a dev
# server the samples are unreachable and the contract refuses them by name.
# Defaults to <origin>/fixtures.
#
# In production this is  https://unisonlabs.tech/fixtures
NEXT_PUBLIC_SAMPLE_BASE=

# This site's own origin, for permalinks and metadata.
#
# In production this is  https://unisonlabs.tech
# Leave it empty locally: it then falls back to Vercel's own url, and to
# http://localhost:4400 on a dev server.
NEXT_PUBLIC_ORIGIN=

# Only for the scripts (npm run deploy / verify / settle). The website never
# reads this and never sends a key anywhere -- an assay is signed in the
# visitor's own wallet. A throwaway key is fine on Studio, which charges nothing.
UNISONLABS_DEPLOYER_KEY=
